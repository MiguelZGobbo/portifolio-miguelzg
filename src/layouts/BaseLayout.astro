---
import '../styles/global.css';
import '@fontsource-variable/ibm-plex-sans';
import { translations, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalUrl: string;
  alternateUrls: {
    'pt-BR': string;
    en: string;
  };
  imageUrl: string;
  imageAlt: string;
  siteName: string;
  structuredData: Record<string, unknown>[];
}

const {
  title,
  description,
  lang,
  canonicalUrl,
  alternateUrls,
  imageUrl,
  imageAlt,
  siteName,
  structuredData,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const dict = translations[lang] as Record<string, string>;
const htmlLang = lang === 'pt' ? 'pt-BR' : 'en';
const openGraphLocale = lang === 'pt' ? 'pt_BR' : 'en_US';
const alternateOpenGraphLocale = lang === 'pt' ? 'en_US' : 'pt_BR';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': structuredData,
}).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={htmlLang} data-theme="light" data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F6F4" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-BR" href={alternateUrls['pt-BR']} />
    <link rel="alternate" hreflang="en" href={alternateUrls.en} />
    <link rel="alternate" hreflang="x-default" href={alternateUrls['pt-BR']} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={openGraphLocale} />
    <meta property="og:locale:alternate" content={alternateOpenGraphLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/svg+xml" href={`${base}img/favicon.svg`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');

        var savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch (e) {}
        var dark = savedTheme
          ? savedTheme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      })();
    </script>
    <script src="../scripts/main.js"></script>
  </head>
  <body data-section="home">
    <a class="skip-link" href="#home" data-i18n="a11y.skip">{dict['a11y.skip']}</a>
    <slot />
  </body>
</html>
