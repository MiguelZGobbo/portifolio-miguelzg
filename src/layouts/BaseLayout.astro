---
import '../styles/global.css';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/dm-sans';
import playfairLatin from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2';
import { translations, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  bodySection?: string;
  skipTarget?: string;
  includeHomeScript?: boolean;
  canonicalUrl?: string;
}

const {
  title,
  description,
  lang = 'pt',
  bodySection = 'home',
  skipTarget = '#home',
  includeHomeScript = true,
  canonicalUrl,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const dict = translations[lang] as Record<string, string>;
const siteUrl = 'https://miguelzgobbo.github.io/portifolio-miguelzg/';
const pageUrl = canonicalUrl ?? siteUrl;
---

<!doctype html>
<html lang={lang} data-theme="light" data-lang={lang} class={bodySection === 'case-study' ? 'case-study-page' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F8F0E5" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${siteUrl}img/foto-perfil.jpeg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}img/favicon.svg`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preload" href={playfairLatin} as="font" type="font/woff2" crossorigin />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Miguel Zager Gobbo',
      jobTitle: 'Software Engineering Student',
      url: siteUrl,
      image: `${siteUrl}img/foto-perfil.jpeg`,
      email: 'mailto:miguelzgobbo@gmail.com',
      sameAs: [
        'https://www.linkedin.com/in/miguel-zager-gobbo',
        'https://github.com/MiguelZGobbo',
      ],
    })} />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');

        var savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch (e) {}
        var dark = savedTheme
          ? savedTheme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      })();
    </script>
    {includeHomeScript && <script src="../scripts/main.js"></script>}
  </head>
  <body data-section={bodySection}>
    <a class="skip-link" href={skipTarget} data-i18n="a11y.skip">{dict['a11y.skip']}</a>
    <slot />
  </body>
</html>
