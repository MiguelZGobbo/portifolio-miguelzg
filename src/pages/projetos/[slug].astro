---
import CaseStudyPage from '../../components/pages/CaseStudyPage.astro';
import { caseStudyProjects, type CaseStudyProject } from '../../data/projects';
import type { Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return caseStudyProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CaseStudyProject;
}

const { project } = Astro.props;
const lang: Lang = 'pt';
---

<CaseStudyPage lang={lang} project={project} />
