---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Particles from '../components/Particles.astro';
import Waves from '../components/Waves.astro';
import ContactSection from '../components/home/ContactSection.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ProfileSection from '../components/home/ProfileSection.astro';
import ProjectsSection from '../components/home/ProjectsSection.astro';
import SkillsSection from '../components/home/SkillsSection.astro';
import { translations, type Lang } from '../lib/i18n';

const lang: Lang = 'pt';
const dict = translations[lang] as Record<string, string>;
---

<BaseLayout
  lang={lang}
  title={dict['meta.title']}
  description={dict['meta.description']}
>
  <Waves />
  <Particles />
  <Nav lang={lang} />

  <main class="scroll-container">
    <HeroSection lang={lang} />
    <ProjectsSection lang={lang} />
    <SkillsSection lang={lang} />
    <ProfileSection lang={lang} />
    <ContactSection lang={lang} />
  </main>
</BaseLayout>
