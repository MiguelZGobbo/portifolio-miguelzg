---
import Icon from './Icon.astro';

const links = [
  { id: 'home', label: 'Início', aria: 'Ir para a seção Início', icon: 'home' },
  { id: 'sobre', label: 'Sobre', aria: 'Ir para a seção Sobre mim', icon: 'user' },
  { id: 'habilidades', label: 'Habilidades', aria: 'Ir para a seção Habilidades', icon: 'code' },
  { id: 'projetos', label: 'Projetos', aria: 'Ir para a seção Projetos', icon: 'folder' },
  { id: 'cv', label: 'Currículo', aria: 'Ir para a seção Currículo', icon: 'file' },
  { id: 'contato', label: 'Contato', aria: 'Ir para a seção Contato', icon: 'mail' },
] as const;
---

<nav aria-label="Navegação principal">
  <div class="logo">MIGUEL ZAGER GOBBO</div>
  <div class="nav-links">
    {
      links.map((link) => (
        <a
          href={`#${link.id}`}
          aria-label={link.aria}
          aria-current={link.id === 'home' ? 'page' : undefined}
        >
          <span class="nav-text">{link.label}</span>
          <Icon name={link.icon} size={15} strokeWidth={2.2} class="nav-icon" />
          <span class="nav-tooltip">{link.label}</span>
        </a>
      ))
    }
  </div>
</nav>
