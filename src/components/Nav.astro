---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import { translations, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
  homeHref?: string;
  showControls?: boolean;
}

const { lang = 'pt', homeHref = '', showControls = true } = Astro.props;
const dict = translations[lang] as Record<string, string>;

const links = [
  { id: 'projetos', icon: 'folder' },
  { id: 'sobre', icon: 'user' },
  { id: 'cv', icon: 'file' },
  { id: 'contato', icon: 'mail' },
] as const;
---

<nav aria-label={dict['a11y.nav']}>
  <a href={`${homeHref}#home`} class="logo" data-i18n="nav.logo" data-i18n-aria="nav.logo.aria" aria-label={dict['nav.logo.aria']}>{dict['nav.logo']}</a>
  <div class="nav-right">
    <div class="nav-links">
      {
        links.map((link) => (
          <a
            href={`${homeHref}#${link.id}`}
            data-i18n-aria={`nav.${link.id}.aria`}
            aria-label={dict[`nav.${link.id}.aria`]}
          >
            <span class="nav-text" data-i18n={`nav.${link.id}`}>{dict[`nav.${link.id}`]}</span>
            <Icon name={link.icon} size={15} strokeWidth={2.2} class="nav-icon" />
            <span class="nav-tooltip" data-i18n={`nav.${link.id}`}>{dict[`nav.${link.id}`]}</span>
          </a>
        ))
      }
    </div>
    {
      showControls && (
        <div class="nav-controls">
          <LangToggle lang={lang} />
          <ThemeToggle lang={lang} />
        </div>
      )
    }
  </div>
</nav>
