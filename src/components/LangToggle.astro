---
import { translate, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
  alternateHref: string;
  alternateSectionHrefs?: Record<string, string>;
}

const { lang = 'pt', alternateHref, alternateSectionHrefs } = Astro.props;
const alternateHreflang = lang === 'pt' ? 'en' : 'pt-BR';
---

<a
  id="lang-toggle"
  class="nav-btn nav-btn--lang"
  href={alternateHref}
  data-language-default={alternateHref}
  data-language-sections={alternateSectionHrefs ? JSON.stringify(alternateSectionHrefs) : undefined}
  hreflang={alternateHreflang}
  aria-label={translate(lang, 'lang.switch')}
>
  <span class="lang-label">
    <span class="lang-part lang-pt">PT</span>
    <span class="lang-sep">/</span>
    <span class="lang-part lang-en">EN</span>
  </span>
</a>
