---
import { translate, type Lang } from '../lib/i18n';
import { contactFields } from '../data/contact-fields';

interface Props {
  lang?: Lang;
}

const { lang = 'pt' } = Astro.props;
---

<div class="contact-form">
  <form id="contact-form">
    <div class="contact-fields reveal">
      {
        contactFields.map((field) => (
          <div class="form-group reveal">
            <label for={field.id} data-i18n={field.labelKey}>{translate(lang, field.labelKey)}</label>
            {
              field.type === 'textarea'
                ? <textarea id={field.id} name={field.key} autocomplete={field.autocomplete} required aria-invalid="false" aria-describedby={field.errorId} placeholder={translate(lang, field.phKey)} data-i18n-ph={field.phKey}></textarea>
                : <input type={field.type} id={field.id} name={field.key} autocomplete={field.autocomplete} required aria-invalid="false" aria-describedby={field.errorId} placeholder={translate(lang, field.phKey)} data-i18n-ph={field.phKey} />
            }
            <p class="field-error" id={field.errorId}></p>
          </div>
        ))
      }
    </div>
    <div class="hp-field" aria-hidden="true" inert>
      <label for="campo-site">Website</label>
      <input type="text" id="campo-site" name="website" autocomplete="off" />
    </div>
    <button class="btn reveal" type="button" id="btn-enviar" data-i18n="form.submit" disabled>{translate(lang, 'form.submit')}</button>
    <p id="form-aviso" role="status" aria-live="polite" aria-atomic="true"></p>
    <noscript>
      <p class="form-fallback">
        <span data-i18n="form.nojs">{translate(lang, 'form.nojs')}</span>{' '}
        <a href="mailto:miguelzgobbo@gmail.com">miguelzgobbo@gmail.com</a>
      </p>
    </noscript>
  </form>
</div>
