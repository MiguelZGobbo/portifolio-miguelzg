---
import { translate, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'pt' } = Astro.props;

const fields = [
  { type: 'text', id: 'campo-nome', labelKey: 'form.name', phKey: 'form.name.ph' },
  { type: 'email', id: 'campo-email', labelKey: 'form.email', phKey: 'form.email.ph' },
  { type: 'textarea', id: 'campo-mensagem', labelKey: 'form.message', phKey: 'form.message.ph' },
] as const;
---

<div class="contact-form reveal">
  <form id="contact-form">
    {
      fields.map((field) => (
        <div class="form-group reveal">
          <label for={field.id} data-i18n={field.labelKey}>{translate(lang, field.labelKey)}</label>
          {
            field.type === 'textarea'
              ? <textarea id={field.id} placeholder={translate(lang, field.phKey)} data-i18n-ph={field.phKey}></textarea>
              : <input type={field.type} id={field.id} placeholder={translate(lang, field.phKey)} data-i18n-ph={field.phKey} />
          }
        </div>
      ))
    }
    <div class="hp-field" aria-hidden="true">
      <label for="campo-site">Website</label>
      <input type="text" id="campo-site" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <button class="btn reveal" type="submit" id="btn-enviar" data-i18n="form.submit">{translate(lang, 'form.submit')}</button>
    <span id="form-aviso"></span>
  </form>
</div>
