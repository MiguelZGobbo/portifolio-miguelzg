---
import { translate, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'pt' } = Astro.props;

const fields = [
  { type: 'text', id: 'campo-nome', name: 'name', autocomplete: 'name', labelKey: 'form.name', phKey: 'form.name.ph' },
  { type: 'email', id: 'campo-email', name: 'email', autocomplete: 'email', labelKey: 'form.email', phKey: 'form.email.ph' },
  { type: 'textarea', id: 'campo-mensagem', name: 'message', autocomplete: 'off', labelKey: 'form.message', phKey: 'form.message.ph' },
] as const;
---

<div class="contact-form reveal">
  <form id="contact-form">
    {
      fields.map((field) => (
        <div class="form-group reveal">
          <label for={field.id} data-i18n={field.labelKey}>{translate(lang, field.labelKey)}</label>
          {
            field.type === 'textarea'
              ? <textarea id={field.id} name={field.name} autocomplete={field.autocomplete} required aria-invalid="false" aria-describedby={`${field.id}-error`} placeholder={translate(lang, field.phKey)} data-i18n-ph={field.phKey}></textarea>
              : <input type={field.type} id={field.id} name={field.name} autocomplete={field.autocomplete} required aria-invalid="false" aria-describedby={`${field.id}-error`} placeholder={translate(lang, field.phKey)} data-i18n-ph={field.phKey} />
          }
          <p class="field-error" id={`${field.id}-error`}></p>
        </div>
      ))
    }
    <div class="hp-field" aria-hidden="true" inert>
      <label for="campo-site">Website</label>
      <input type="text" id="campo-site" name="website" autocomplete="off" />
    </div>
    <button class="btn reveal" type="button" id="btn-enviar" data-i18n="form.submit" disabled>{translate(lang, 'form.submit')}</button>
    <p id="form-aviso" role="status" aria-live="polite" aria-atomic="true"></p>
    <noscript>
      <p class="form-fallback">
        <span data-i18n="form.nojs">{translate(lang, 'form.nojs')}</span>{' '}
        <a href="mailto:miguelzgobbo@gmail.com">miguelzgobbo@gmail.com</a>
      </p>
    </noscript>
  </form>
</div>
