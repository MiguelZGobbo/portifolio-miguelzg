---
import type { SkillGroup } from '../data/skills';
import type { Lang } from '../lib/i18n';

interface Props {
  group: SkillGroup;
  lang?: Lang;
}

const { group, lang = 'pt' } = Astro.props;
---

<div class="skill-card reveal">
  <div class="skill-cat">{group.cat[lang]}</div>
  <div class="skill-tags">
    {group.tags[lang].map((tag) => <span class="tag">{tag}</span>)}
  </div>
</div>
