---
import { translate, type Lang } from '../lib/i18n';

interface Props {
  labelKey: string;
  titleKey: string;
  lang?: Lang;
}

const { labelKey, titleKey, lang = 'pt' } = Astro.props;
---

<div class="section-heading reveal">
  <h2 class="section-title"><span data-i18n={titleKey}>{translate(lang, titleKey)}</span></h2>
  <p class="section-description" data-i18n={labelKey}>{translate(lang, labelKey)}</p>
</div>
