---
import Icon from './Icon.astro';
import { translate, type Lang } from '../lib/i18n';

interface Props {
  labelKey: string;
  titleKey: string;
  icon: Parameters<typeof Icon>[0]['name'];
  lang?: Lang;
}

const { labelKey, titleKey, icon, lang = 'pt' } = Astro.props;
---

<div class="section-label reveal" data-i18n={labelKey}>{translate(lang, labelKey)}</div>
<div class="section-title reveal">
  <Icon name={icon} size={22} strokeWidth={1.8} />
  <span data-i18n={titleKey}>{translate(lang, titleKey)}</span>
</div>
