---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import { translations, type Lang } from '../lib/i18n';

interface Props {
  projects: Project[];
  lang?: Lang;
}

const { projects, lang = 'pt' } = Astro.props;
const dict = translations[lang] as Record<string, string>;
const projectImages = import.meta.glob<ImageMetadata>('../assets/projects/*.{png,jpg,webp,svg}', { eager: true, import: 'default' });
const fullImages = Object.fromEntries(await Promise.all(projects.filter(project => project.image).map(async project => {
  const source = projectImages[`../assets/projects/${project.image!.src}`];
  const image = await getImage({ src: source, width: source.width, format: source.format === 'svg' ? 'svg' : 'webp', quality: 90 });
  return [project.slug, image];
})));
---

<div class="project-list">
  {
    projects.map((project) => (
      <article
        class:list={['project-entry', 'reveal', { 'project-entry--with-image': Boolean(project.image) }]}
        data-project={project.slug}
        data-hierarchy={project.hierarchy}
        aria-labelledby={`project-${project.slug}`}
      >
        {project.image && (
            <a
              class="project-media project-preview-link"
              href={fullImages[project.slug].src}
              data-viewer-trigger
              data-title={project.name[lang]}
              data-description={project.image.alt[lang]}
              data-caption={project.image.caption?.[lang] ?? ''}
              data-width={projectImages[`../assets/projects/${project.image.src}`].width}
              data-height={projectImages[`../assets/projects/${project.image.src}`].height}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${dict['projects.enlarge']}: ${project.name[lang]}${project.image.caption ? ` — ${project.image.caption[lang]}` : ''}`}
            >
              <figure>
              <Image
                src={projectImages[`../assets/projects/${project.image.src}`]}
                alt={project.image.alt[lang]}
                width={640}
                widths={[320, 640, 960, 1280]}
                sizes="auto, 100vw"
                loading="lazy"
                decoding="async"
                class="project-thumbnail"
              />
            <figcaption>
              {project.image.caption && <span>{project.image.caption[lang]}</span>}
              <svg class="project-expand-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg>
            </figcaption>
              </figure>
            </a>
        )}
        <div class="project-entry-copy">
          <h3 class="project-name" id={`project-${project.slug}`}>{project.name[lang]}</h3>
          <p class="project-meta">
            <span class="project-kind">{project.showcase.kind[lang]}</span>
            <span class="project-state">{project.state[lang]}</span>
          </p>
          <p class="project-summary">{project.showcase.summary[lang]}</p>

          <ul class="project-technologies" aria-label={dict['projects.technologies']}>
            {project.showcase.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
          <ul class="project-aspects" aria-label={dict['projects.aspects']}>
            {project.showcase.aspects.map((aspect) => <li>{aspect[lang]}</li>)}
          </ul>
          <div class="project-actions">
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link project-github-link"
              aria-label={project.ariaLabel[lang]}
            >
              <Icon name="github" size={16} />
              <span>{dict['projects.github']}</span>
              <Icon name="external" size={16} strokeWidth={2} />
            </a>
          </div>
        </div>
      </article>
    ))
  }
</div>

<dialog class="project-viewer" data-project-viewer aria-labelledby="project-viewer-title" aria-describedby="project-viewer-caption">
  <div class="project-viewer-header">
    <h2 id="project-viewer-title"></h2>
    <button type="button" data-viewer-close aria-label={dict['projects.close']} autofocus><span aria-hidden="true">×</span></button>
  </div>
  <div class="project-viewer-viewport">
    <img data-viewer-image alt="" />
  </div>
  <div class="project-viewer-footer">
    <p id="project-viewer-caption" data-viewer-caption></p>
    <p data-viewer-error role="status" hidden>{dict['projects.imageError']}</p>
  </div>
</dialog>
