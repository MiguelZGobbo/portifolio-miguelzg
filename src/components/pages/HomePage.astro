---
import ContactSection from '../home/ContactSection.astro';
import HeroSection from '../home/HeroSection.astro';
import ProfileSection from '../home/ProfileSection.astro';
import ProjectsSection from '../home/ProjectsSection.astro';
import SkillsSection from '../home/SkillsSection.astro';
import Nav from '../Nav.astro';
import Waves from '../Waves.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudyProjects } from '../../data/projects';
import { caseStudyPath, homePath, pageUrl, routeConfig, type RouteSection } from '../../lib/routes';
import { translations, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = translations[lang] as Record<string, string>;
const base = import.meta.env.BASE_URL;
if (!Astro.site) throw new Error('Astro site URL is required to generate canonical metadata.');
const sections = routeConfig[lang].sections;
const alternateLang: Lang = lang === 'pt' ? 'en' : 'pt';
const alternateHomeHref = homePath(base, alternateLang);
const alternateSectionHrefs = Object.fromEntries(
  (Object.keys(sections) as RouteSection[])
    .filter((section) => section !== 'home')
    .map((section) => [section, homePath(base, alternateLang, section)]),
) as Partial<Record<RouteSection, string>>;
const caseStudyHrefs = Object.fromEntries(
  caseStudyProjects.map((project) => [project.slug, caseStudyPath(base, lang, project.slug)]),
);
const canonicalUrl = pageUrl(Astro.site.origin, homePath(base, lang));
const alternateUrls = {
  'pt-BR': pageUrl(Astro.site.origin, homePath(base, 'pt')),
  en: pageUrl(Astro.site.origin, homePath(base, 'en')),
};
const imageUrl = pageUrl(Astro.site.origin, `${base}img/foto-perfil.jpeg`);
const title = dict['meta.title'];
const description = dict['meta.description'];
const personId = `${canonicalUrl}#person`;
const structuredData = [
  {
    '@type': 'WebPage',
    '@id': canonicalUrl,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage: lang === 'pt' ? 'pt-BR' : 'en',
    mainEntity: { '@id': personId },
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Miguel Zager Gobbo',
    jobTitle: dict['hero.title'],
    image: imageUrl,
    email: 'mailto:miguelzgobbo@gmail.com',
    sameAs: [
      'https://www.linkedin.com/in/miguel-zager-gobbo',
      'https://github.com/MiguelZGobbo',
    ],
  },
];
const siteName = lang === 'pt' ? 'Portfólio de Miguel Zager Gobbo' : 'Miguel Zager Gobbo Portfolio';
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  alternateUrls={alternateUrls}
  pageKind="website"
  imageUrl={imageUrl}
  imageAlt={dict['img.profile.alt']}
  siteName={siteName}
  structuredData={structuredData}
>
  <Waves />
  <Nav
    lang={lang}
    sectionIds={sections}
    alternateHref={alternateHomeHref}
    alternateSectionHrefs={alternateSectionHrefs}
  />

  <main class="home-main">
    <HeroSection lang={lang} sectionIds={sections} />
    <ProjectsSection lang={lang} id={sections.projects} caseStudyHrefs={caseStudyHrefs} />
    <SkillsSection lang={lang} id={sections.skills} />
    <ProfileSection lang={lang} id={sections.about} resumeId={sections.resume} />
    <ContactSection lang={lang} id={sections.contact} />
  </main>
</BaseLayout>
