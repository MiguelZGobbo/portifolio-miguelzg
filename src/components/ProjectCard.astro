---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';

interface Props extends Project {}

const { name, desc, stack, href, ariaLabel } = Astro.props;
---

<div class="project-card reveal">
  <div>
    <div class="project-name">{name}</div>
    <div class="project-desc">{desc}</div>
    <div class="project-stack">
      {stack.map((tag) => <span class="stack-tag">{tag}</span>)}
    </div>
  </div>
  <a href={href} target="_blank" rel="noopener noreferrer" class="project-link" aria-label={ariaLabel}>
    <Icon name="github" size={14} />
    GitHub
    <Icon name="external" size={11} strokeWidth={2.5} />
  </a>
</div>
