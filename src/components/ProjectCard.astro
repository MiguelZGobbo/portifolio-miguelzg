---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import { translations, type Lang } from '../lib/i18n';

interface Props {
  project: Project;
  lang?: Lang;
}

const { project, lang = 'pt' } = Astro.props;
const dict = translations[lang] as Record<string, string>;
const cardClasses = [
  'project-card',
  'reveal',
  `project-card--${project.hierarchy.toLowerCase()}`,
  ...(project.compact ? ['project-card--compact'] : []),
];
const caseStudyHref = `${import.meta.env.BASE_URL}projetos/${project.slug}/`;
const caseStudyAria = {
  pt: `Ver estudo de caso de ${project.name.pt}`,
  en: `View ${project.name.en} case study`,
};
---

<article
  class:list={cardClasses}
  data-project={project.slug}
  data-project-hierarchy={project.hierarchy}
  data-project-compact={project.compact ? 'true' : undefined}
>
  <div class="project-card-inner">
    <header class="project-card-header">
      <div>
        <p class="project-level" data-i18n={`projects.level.${project.hierarchy}`}>{dict[`projects.level.${project.hierarchy}`]}</p>
        <h3 class="project-name" data-project-localized data-project-pt={project.name.pt} data-project-en={project.name.en}>{project.name[lang]}</h3>
      </div>
      <p
        class:list={['project-state', `project-state--${project.stateKey}`]}
        data-project-state={project.stateKey}
        data-project-localized
        data-project-pt={project.state.pt}
        data-project-en={project.state.en}
      >
        {project.state[lang]}
      </p>
    </header>
    <p class="project-desc project-summary" data-project-localized data-project-pt={project.summary.pt} data-project-en={project.summary.en}>{project.summary[lang]}</p>
    {
      (project.origin || project.contribution) && (
        <dl class="project-facts">
          {
            project.origin && (
              <div class="project-fact">
                <dt data-i18n="projects.origin">{dict['projects.origin']}</dt>
                <dd data-project-localized data-project-pt={project.origin.pt} data-project-en={project.origin.en}>{project.origin[lang]}</dd>
              </div>
            )
          }
          {
            project.contribution && (
              <div class="project-fact">
                <dt data-i18n="projects.contribution">{dict['projects.contribution']}</dt>
                <dd data-project-localized data-project-pt={project.contribution.pt} data-project-en={project.contribution.en}>{project.contribution[lang]}</dd>
              </div>
            )
          }
        </dl>
      )
    }
    <div class="project-stack">
      {project.stack.map((tag) => <span class="stack-tag">{tag}</span>)}
    </div>
    {
      !project.compact && (
        <div class="project-evidence">
          <p class="project-evidence-title" data-i18n="projects.evidence">{dict['projects.evidence']}</p>
          <ul>
            {project.evidence.map((item) => <li data-project-localized data-project-pt={item.pt} data-project-en={item.en}>{item[lang]}</li>)}
          </ul>
        </div>
      )
    }
  </div>
  <div class="project-actions">
    {
      project.caseStudy && (
        <a
          href={caseStudyHref}
          class="project-link project-case-study-link"
          aria-label={caseStudyAria[lang]}
          data-project-localized-aria
          data-project-pt={caseStudyAria.pt}
          data-project-en={caseStudyAria.en}
        >
          <Icon name="eye" size={14} />
          <span data-i18n="projects.caseStudy">{dict['projects.caseStudy']}</span>
        </a>
      )
    }
    <a
      href={project.href}
      target="_blank"
      rel="noopener noreferrer"
      class="project-link project-github-link"
      aria-label={project.ariaLabel[lang]}
      data-project-localized-aria
      data-project-pt={project.ariaLabel.pt}
      data-project-en={project.ariaLabel.en}
    >
      <Icon name="github" size={14} />
      <span data-i18n="projects.github">{dict['projects.github']}</span>
      <Icon name="external" size={11} strokeWidth={2.5} />
    </a>
  </div>
</article>
