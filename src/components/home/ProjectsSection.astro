---
import ProjectList from '../ProjectList.astro';
import SectionTitle from '../SectionTitle.astro';
import { projects } from '../../data/projects';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
  id: string;
}

const { lang = 'pt', id } = Astro.props;
---

<section class="snap-section home-section home-section--projects" id={id}>
  <div class="section-inner">
    <SectionTitle lang={lang} labelKey="projects.label" titleKey="projects.title" />
    <ProjectList projects={projects} lang={lang} />
  </div>
</section>
