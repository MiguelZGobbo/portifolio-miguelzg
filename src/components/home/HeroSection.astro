---
import { Image } from 'astro:assets';
import foto from '../../assets/foto-perfil.jpeg';
import { translations, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'pt' } = Astro.props;
const dict = translations[lang];
---

<section class="snap-section home-section home-section--hero" id="home">
  <div class="section-inner hero-inner">
    <div class="hero-text">
      <h1 class="hero-title reveal" data-i18n="hero.title">{dict['hero.title']}</h1>
      <p class="hero-sub reveal" data-i18n="hero.sub">{dict['hero.sub']}</p>
      <p class="hero-availability reveal" data-i18n="hero.availability">{dict['hero.availability']}</p>
    </div>
    <div class="hero-photo reveal">
      <Image
        src={foto}
        alt={dict['img.profile.alt']}
        data-i18n-alt="img.profile.alt"
        class="profile-photo"
        fetchpriority="high"
        loading="eager"
        decoding="sync"
        width={480}
        widths={[120, 180, 240, 360, 480]}
        sizes="min(calc(100vw - 2.5rem), clamp(7.5rem, min(19.5vw, 30svh), 15rem))"
      />
    </div>
  </div>
</section>
