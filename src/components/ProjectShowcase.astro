---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import { translations, type Lang } from '../lib/i18n';

interface Props {
  projects: Project[];
  lang?: Lang;
  caseStudyHrefs: Record<string, string>;
}

const { projects, lang = 'pt', caseStudyHrefs } = Astro.props;
const dict = translations[lang] as Record<string, string>;
const total = projects.length;
const initialCounter = `01 / ${String(total).padStart(2, '0')}`;
const caseStudyAria = (project: Project) => lang === 'pt'
  ? `Ver estudo de caso de ${project.name.pt}`
  : `View ${project.name.en} case study`;
---

<div
  class="project-showcase reveal"
  data-project-showcase
  data-project-announcement-template={dict['projects.announcement']}
>
  <header class="project-showcase-toolbar">
    <p class="project-showcase-counter" data-project-counter>{initialCounter}</p>
    <div class="project-showcase-controls">
      <button
        type="button"
        class="project-showcase-arrow"
        data-project-direction="previous"
        aria-label={dict['projects.previous']}
        aria-controls={`project-panel-${projects[0]?.slug}`}
        disabled
      >
        <span aria-hidden="true">←</span>
      </button>
      <button
        type="button"
        class="project-showcase-arrow"
        data-project-direction="next"
        aria-label={dict['projects.next']}
        aria-controls={`project-panel-${projects[1]?.slug ?? projects[0]?.slug}`}
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </header>

  <div class="project-showcase-panels">
    {
      projects.map((project, index) => {
        const isActive = index === 0;
        const panelId = `project-panel-${project.slug}`;

        return (
          <article
            id={panelId}
            class="project-showcase-panel"
            data-project={project.slug}
            data-project-panel
            data-project-index={index}
            data-project-name={project.name[lang]}
            data-active={isActive ? 'true' : undefined}
          >
            <div class="project-showcase-copy">
              <h3 class="project-showcase-name">{project.name[lang]}</h3>
              <p class="project-showcase-summary">{project.showcase.summary[lang]}</p>

              <ul class="project-showcase-technologies" aria-label={dict['projects.technologies']}>
                {project.showcase.technologies.map((technology) => <li>{technology}</li>)}
              </ul>

              <ul class="project-showcase-aspects" aria-label={dict['projects.aspects']}>
                {
                  project.showcase.aspects.map((aspect, aspectIndex) => (
                    <li>
                      <span>{aspect[lang]}</span>
                      {aspectIndex < project.showcase.aspects.length - 1 && <span aria-hidden="true">·</span>}
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="project-showcase-actions">
              {
                project.caseStudy && caseStudyHrefs[project.slug] && (
                  <a
                    href={caseStudyHrefs[project.slug]}
                    class="project-link project-case-study-link"
                    aria-label={caseStudyAria(project)}
                  >
                    <Icon name="eye" size={14} />
                    <span>{dict['projects.caseStudy']}</span>
                  </a>
                )
              }
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link project-github-link"
                aria-label={project.ariaLabel[lang]}
              >
                <Icon name="github" size={14} />
                <span>{dict['projects.github']}</span>
                <Icon name="external" size={11} strokeWidth={2.5} />
              </a>
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="project-showcase-nav" role="navigation" aria-label={dict['projects.directNavigation']}>
    <div class="project-showcase-nav-list">
      {
        projects.map((project, index) => (
          <button
            type="button"
            class="project-showcase-nav-button"
            data-project-select={index}
            aria-controls={`project-panel-${project.slug}`}
            aria-current={index === 0 ? 'true' : undefined}
          >
            {project.name[lang]}
          </button>
        ))
      }
    </div>
  </div>

  <p class="visually-hidden" data-project-announcement role="status" aria-live="polite"></p>
</div>
